CORENAME=JTGAIDEN
JTFRAME_RATE=59.19
JTFRAME_BUTTONS=3
JTFRAME_JOY_UDRL

JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224
JTFRAME_PXLCLK=6
JTFRAME_HEADER=8

# SDRAM
JTFRAME_BA1_START=0x40000
PCM_START=0x50000
JTFRAME_BA2_START=0x70000
OBJ_START=0x80000
JTFRAME_BA3_START=0x180000
GFX3_START=0x200000

JTFRAME_IOCTL_RD=36864
JTFRAME_IOCTL_RD+=14

[mist|sidi]
# not enough BRAM
JTFRAME_SKIP

[mister]
# RetroAchievements: 68K work RAM BRAM (mem.yaml ra_tap), FBNeo All RAM 0-0x3FFF
JTFRAME_RA_MIRROR
JTFRAME_RA_TAP
JTFRAME_RA_AW=14
