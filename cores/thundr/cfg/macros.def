CORENAME=JTTHUNDR
JTFRAME_RATE=60.60

JTFRAME_BUTTONS=3
JTFRAME_CREDITS_HSTART=32
JTFRAME_PLL=jtframe_pll6144
# Video configuration
JTFRAME_PXLCLK=6
JTFRAME_WIDTH=288
JTFRAME_HEIGHT=224

# ROM
JTFRAME_HEADER=8
EXT_START=0x10000
JTFRAME_BA1_START=0x50000
PCM_START=0x60000
JTFRAME_BA2_START=0xD0000
SCR1_START=0xF0000
JTFRAME_BA3_START=0x100000
MCUSUB_START=0x200000
JTFRAME_PROM_START=0x208000

JTFRAME_IOCTL_RD=24576
JTFRAME_IOCTL_RD+=22

[mister]
# RetroAchievements: FBNeo's All Ram (d_namcos86 or d_baraduke layout, from
# offset 0) tapped in jtthundr_game (mem.yaml ports ra_game_*)
JTFRAME_RA_MIRROR
JTFRAME_RA_TAP
