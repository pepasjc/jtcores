CORENAME=JTCPS3
JTFRAME_RATE=59.64
JTFRAME_SKIP_RATE_TEST

JTFRAME_MR_DDRLOAD
JTFRAME_SDRAM_XL
JTFRAME_180SHIFT
JTFRAME_NOHQ2X
JTFRAME_NOMULTIWAY

JTFRAME_LF_BUFFER
JTFRAME_LF_ZOOM
JTFRAME_LF_HW=10
JTFRAME_LF_VW=9

JTFRAME_STEREO
JTFRAME_IOCTL_RD=128

JTFRAME_WIDTH=384
JTFRAME_HEIGHT=224
JTFRAME_SIM_SKIP_VSIZE
JTFRAME_NOHQ2X

JTFRAME_JOY_RLDU
JTFRAME_BUTTONS=6

JTFRAME_COLORW=5
JTFRAME_HEADER=32
# 7 MHz PLL base gives 28/56/112 MHz clocks; pixels are enabled from 56 MHz
JTFRAME_PLL=jtframe_pll7000
JTFRAME_CLK48
JTFRAME_SDRAM96

JTFRAME_CREDITS_HSTART=64

JTFRAME_EASY_STA
[mist|sidi|pocket|sidi128]
# Not enough BRAM
# sidi128: unstable due to timing errors inside SH-2 CPU see cps3/issues/67
# sidi128: support for 128MB SDRAM not done
JTFRAME_SKIP

[mister]
# RetroAchievements: SH-2 main RAM writes tapped in jtcps3_main on the CPU side
# of the write-back cpuba0 lane, 31 x 1 kB pages mapped by jtcps3_ra_map (32 kB
# shadow). The DDR line-frame buffer also uses DDR during VBlank, so the mirror
# arbitrates for the port burst by burst (JTFRAME_RA_DDR_ARB).
JTFRAME_RA_MIRROR
JTFRAME_RA_TAP
JTFRAME_RA_AW=15
JTFRAME_RA_DDR_ARB
